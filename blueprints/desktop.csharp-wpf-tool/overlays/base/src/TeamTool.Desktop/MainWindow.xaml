<Window x:Class="TeamTool.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeamTool" Height="360" Width="640"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="32">
    <StackPanel VerticalAlignment="Center">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="TeamTool" />
      <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Status}" />
      <Button Margin="0,20,0,0" Padding="16,8" HorizontalAlignment="Left"
              Command="{Binding RefreshCommand}" Content="Refresh" />
    </StackPanel>
  </Grid>
</Window>
