<Window x:Class="DevForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dashboard="clr-namespace:DevForge.Desktop.Dashboard"
        xmlns:doctor="clr-namespace:DevForge.Desktop.EnvironmentDoctor"
        xmlns:settings="clr-namespace:DevForge.Desktop.Settings"
        Title="DevForge Studio — Leader Edition"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
            <dashboard:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type doctor:EnvironmentDoctorViewModel}">
            <doctor:EnvironmentDoctorView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="DEVFORGE"
                               FontWeight="Bold"
                               FontSize="18"
                               AutomationProperties.Name="DevForge Studio" />
                    <TextBlock Text="Leader Edition"
                               Foreground="{DynamicResource Brush.MutedForeground}"
                               Margin="0,0,0,20" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Routes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavigationButton}"
                                    Content="{Binding Label}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Route}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="#FFF7C948"
                    Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSafeMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding SafeModeMessage}" Foreground="#FF1B1B1B" TextWrapping="Wrap" />
            </Border>
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Focusable="False" />
            <ItemsControl Grid.Row="2"
                          HorizontalAlignment="Right"
                          Margin="16"
                          ItemsSource="{Binding Notifications.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Message}" MaxWidth="420" TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
