<Window x:Class="DevForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:catalog="clr-namespace:DevForge.Desktop.BlueprintCatalog"
        xmlns:create="clr-namespace:DevForge.Desktop.CreateProject"
        xmlns:dashboard="clr-namespace:DevForge.Desktop.Dashboard"
        xmlns:doctor="clr-namespace:DevForge.Desktop.EnvironmentDoctor"
        xmlns:execution="clr-namespace:DevForge.Desktop.Execution"
        xmlns:history="clr-namespace:DevForge.Desktop.RunHistory"
        xmlns:notifications="clr-namespace:DevForge.Desktop.Notifications"
        xmlns:presentation="clr-namespace:DevForge.Desktop.Presentation"
        xmlns:settings="clr-namespace:DevForge.Desktop.Settings"
        x:Name="RootWindow"
        Title="DevForge Studio — Leader Edition"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <presentation:DoubleLessThanConverter x:Key="WidthLessThan" />
        <presentation:EqualityMultiConverter x:Key="ValuesEqual" />

        <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
            <dashboard:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type doctor:EnvironmentDoctorViewModel}">
            <doctor:EnvironmentDoctorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type create:CreateProjectViewModel}">
            <create:CreateProjectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type catalog:BlueprintCatalogViewModel}">
            <catalog:BlueprintCatalogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type history:RunHistoryViewModel}">
            <history:RunHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type execution:ExecutionCenterViewModel}">
            <execution:ExecutionCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type execution:LocalReadyViewModel}">
            <execution:LocalReadyView />
        </DataTemplate>

        <Style x:Key="CompactHiddenText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="ActualWidth"
                                 RelativeSource="{RelativeSource AncestorType=Window}"
                                 Converter="{StaticResource WidthLessThan}"
                                 ConverterParameter="1100" />
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavigationIcon" TargetType="TextBlock">
            <Setter Property="Text" Value="{StaticResource Icon.Dashboard}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconKey}" Value="Add">
                    <Setter Property="Text" Value="{StaticResource Icon.Create}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="Folder">
                    <Setter Property="Text" Value="{StaticResource Icon.History}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="Catalog">
                    <Setter Property="Text" Value="{StaticResource Icon.Catalog}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="Health">
                    <Setter Property="Text" Value="{StaticResource Icon.Health}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="Settings">
                    <Setter Property="Text" Value="{StaticResource Icon.Settings}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellRoot" Background="{DynamicResource Brush.AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0"
                AutomationProperties.Name="Primary navigation">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="248" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Navigation}" />
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <Binding Path="ActualWidth"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{StaticResource WidthLessThan}"
                                         ConverterParameter="1100" />
                            </DataTrigger.Binding>
                            <Setter Property="Width" Value="80" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Margin="14,20,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,6,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40"
                            Height="40"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="11"
                            AutomationProperties.Name="DevForge Studio">
                        <Grid>
                            <TextBlock Text="DF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold" />
                            <Border Width="10"
                                    Height="3"
                                    Margin="0,0,7,7"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#BFFFFFFF"
                                    CornerRadius="2" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,1,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="ActualWidth"
                                                     RelativeSource="{RelativeSource AncestorType=Window}"
                                                     Converter="{StaticResource WidthLessThan}"
                                                     ConverterParameter="1100" />
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="DEVFORGE" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Leader Edition" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Routes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource NavigationButton}"
                                              Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding Route}"
                                              IsEnabled="{Binding IsEnabled}"
                                              ToolTipService.ToolTip="{Binding Label}"
                                              AutomationProperties.Name="{Binding Label}"
                                              AutomationProperties.HelpText="{Binding DisabledReason}">
                                    <ToggleButton.IsChecked>
                                        <MultiBinding Mode="OneWay" Converter="{StaticResource ValuesEqual}">
                                            <Binding Path="Route" />
                                            <Binding Path="DataContext.CurrentRoute"
                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </ToggleButton.IsChecked>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource NavigationIcon}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Label}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <Binding Path="ActualWidth"
                                                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                                                         Converter="{StaticResource WidthLessThan}"
                                                                         ConverterParameter="1100" />
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Padding="12"
                        Background="{DynamicResource Brush.SurfaceRaised}"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{StaticResource Icon.Info}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Icon}"
                                   Foreground="{DynamicResource Brush.Success}"
                                   FontSize="15" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="ActualWidth"
                                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                                         Converter="{StaticResource WidthLessThan}"
                                                         ConverterParameter="1100" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Local-first" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="Private by design" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="20,16,20,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Callout.Warning}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSafeMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{StaticResource Icon.Warning}"
                               Margin="0,1,12,0"
                               FontFamily="{StaticResource Font.Icon}"
                               FontSize="18"
                               Foreground="{DynamicResource Brush.Warning}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Safe mode" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SafeModeMessage}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Safe mode message"
                                   AutomationProperties.HelpText="Mutating actions are disabled while DevForge is in safe mode." />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Focusable="False"
                            AutomationProperties.Name="Page content" />

            <ItemsControl Grid.RowSpan="2"
                          Panel.ZIndex="20"
                          Margin="20"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          ItemsSource="{Binding Notifications.Items}"
                          AutomationProperties.Name="Notifications">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ToastCard}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}"
                                                     Value="{x:Static notifications:NotificationSeverity.Warning}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}"
                                                     Value="{x:Static notifications:NotificationSeverity.Error}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,1,10,0"
                                           FontFamily="{StaticResource Font.Icon}"
                                           FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{StaticResource Icon.Info}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}"
                                                             Value="{x:Static notifications:NotificationSeverity.Warning}">
                                                    <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}"
                                                             Value="{x:Static notifications:NotificationSeverity.Error}">
                                                    <Setter Property="Text" Value="{StaticResource Icon.Error}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           MaxWidth="360"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="{Binding Message}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
