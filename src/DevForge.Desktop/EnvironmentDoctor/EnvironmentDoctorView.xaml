<UserControl x:Class="DevForge.Desktop.EnvironmentDoctor.EnvironmentDoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:persistence="clr-namespace:DevForge.Application.Contracts.Persistence;assembly=DevForge.Application"
             AutomationProperties.Name="Environment Doctor">
    <Grid Margin="{StaticResource Page.Padding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Margin="20,0,0,0"
                        Orientation="Horizontal">
                <Button Style="{StaticResource Button.Secondary}"
                        Margin="0,0,8,0"
                        Command="{Binding CopyDiagnosticsCommand}"
                        AutomationProperties.Name="Copy environment diagnostics">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   FontFamily="{StaticResource Font.Icon}"
                                   Text="{StaticResource Icon.Copy}" />
                        <TextBlock Text="Copy diagnostics" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding RescanCommand}"
                        AutomationProperties.Name="Rescan environment">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   FontFamily="{StaticResource Font.Icon}"
                                   Foreground="White"
                                   Text="{StaticResource Icon.Refresh}" />
                        <TextBlock Foreground="White" Text="Rescan" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}"
                           Margin="0,0,0,5"
                           Foreground="{DynamicResource Brush.Accent}"
                           FontWeight="SemiBold"
                           Text="LOCAL TOOLCHAIN" />
                <TextBlock Style="{StaticResource PageHeading}" Text="Environment Doctor" />
                <TextBlock Style="{StaticResource PageDescription}"
                           Text="Verify trusted tools and compatibility before creating a project." />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Last scanned" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="6,0,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding LastScannedAt, StringFormat={}{0:g}, TargetNullValue=Never}" />
                    <Border Margin="12,-2,0,0" Style="{StaticResource StatusBadge}">
                        <TextBlock FontSize="11"
                                   Text="{Binding Tools.Count, StringFormat={}{0} tools}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <Border Margin="0,0,0,12"
                    Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Callout.Warning}" />
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{StaticResource Icon.Warning}"
                               Margin="0,1,12,0"
                               FontFamily="{StaticResource Font.Icon}"
                               FontSize="18"
                               Foreground="{DynamicResource Brush.Warning}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="Cached results are stale" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="Rescan to verify the current toolchain before creating a project."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="0,0,0,12"
                    Visibility="{Binding ScanFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Callout.Error}" />
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{StaticResource Icon.Error}"
                               Margin="0,1,12,0"
                               FontFamily="{StaticResource Font.Icon}"
                               FontSize="18"
                               Foreground="{DynamicResource Brush.Error}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="Scan failed; cached results shown" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="The last safe snapshot remains visible. Review it before retrying the scan."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource Card}" Padding="0">
                <ListView ItemsSource="{Binding Tools}"
                          BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Environment tool status list">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Height" Value="42" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="56" />
                            <Setter Property="Padding" Value="6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="TOOL" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0" Orientation="Horizontal">
                                            <Border Width="30"
                                                    Height="30"
                                                    Background="{DynamicResource Brush.AccentSubtle}"
                                                    CornerRadius="7">
                                                <TextBlock Text="{StaticResource Icon.Code}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource Font.Icon}"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                            <TextBlock Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Id}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="VERSION" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   Text="{Binding Version, TargetNullValue=Not detected}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="STATUS" Width="155">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="8,0" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static persistence:EnvironmentToolStatus.Installed}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSurface}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static persistence:EnvironmentToolStatus.Compatible}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSurface}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static persistence:EnvironmentToolStatus.Outdated}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningSurface}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static persistence:EnvironmentToolStatus.Missing}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningSurface}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static persistence:EnvironmentToolStatus.Conflicting}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.ErrorSurface}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,6,0" Text="{Binding StatusGlyph}" />
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding StatusLabel}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="COMPATIBILITY" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Width="300"
                                                   Margin="8,8"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CompatibilitySummary}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="REMEDIATION" Width="360">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Width="330"
                                                   Margin="8,8"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="{Binding Remediation}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tools.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Width="320">
                    <TextBlock Style="{StaticResource EmptyStateIcon}"
                               Text="{StaticResource Icon.Health}" />
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="No environment snapshot" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="0,6,0,14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Run a trusted scan to inspect the local toolchain." />
                    <Button Style="{StaticResource Button.Primary}"
                            HorizontalAlignment="Center"
                            Content="Scan environment"
                            Command="{Binding RescanCommand}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource Brush.AppBackground}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Scanning environment">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="190" Height="3" IsIndeterminate="True" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="0,10,0,0"
                               Text="Checking trusted tool locations…" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
