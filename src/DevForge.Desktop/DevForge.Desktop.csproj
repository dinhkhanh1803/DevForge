<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DevForge.Application\DevForge.Application.csproj" />
    <ProjectReference Include="..\DevForge.Blueprints.BuiltIn\DevForge.Blueprints.BuiltIn.csproj" />
    <ProjectReference Include="..\DevForge.Infrastructure\DevForge.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\blueprints\**\*">
      <Link>blueprints\built-in\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
