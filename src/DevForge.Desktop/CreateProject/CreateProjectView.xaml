<UserControl x:Class="DevForge.Desktop.CreateProject.CreateProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:DevForge.Application.Contracts;assembly=DevForge.Application"
             xmlns:execution="clr-namespace:DevForge.Desktop.Execution"
             xmlns:blueprints="clr-namespace:DevForge.Blueprints.Abstractions.Models;assembly=DevForge.Blueprints.Abstractions"
             AutomationProperties.Name="Create Project">
    <UserControl.Resources>
        <DataTemplate x:Key="TextInputTemplate">
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding Id}" />
        </DataTemplate>
        <DataTemplate x:Key="ChoiceInputTemplate">
            <ComboBox ItemsSource="{Binding AllowedValues}"
                      SelectedItem="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{Binding Id}" />
        </DataTemplate>
        <DataTemplate x:Key="BooleanInputTemplate">
            <CheckBox IsChecked="{Binding BooleanValue}"
                      Content="Enabled"
                      AutomationProperties.Name="{Binding Id}" />
        </DataTemplate>
        <DataTemplate x:Key="WholeNumberInputTemplate">
            <TextBox Text="{Binding WholeNumberValue, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding Id}" />
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <StackPanel Margin="{StaticResource Page.Padding}" MaxWidth="840" HorizontalAlignment="Left">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="{x:Static contracts:ProjectCreationStage.Execute}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Stage}" Value="{x:Static contracts:ProjectCreationStage.LocalReady}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource PageHeading}" Text="Create Project" />
            <TextBlock Margin="0,0,0,20"
                       Foreground="{DynamicResource Brush.MutedForeground}"
                       Text="Configure a trusted blueprint, then review the exact plan before execution." />

            <TextBlock Style="{StaticResource SectionHeading}" Text="Project" />
            <TextBlock Text="Project name" />
            <TextBox Margin="0,4,0,12" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Parent folder" />
            <TextBox Margin="0,4,0,12" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Output folder" />
            <TextBox Margin="0,4,0,12" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Blueprint" />
            <ComboBox Margin="0,4,0,12"
                      ItemsSource="{Binding Blueprints}"
                      SelectedItem="{Binding SelectedBlueprint}"
                      DisplayMemberPath="Manifest.Id" />

            <TextBlock Style="{StaticResource SectionHeading}" Text="Blueprint options" />
            <ItemsControl ItemsSource="{Binding Inputs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextInputTemplate}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static blueprints:BlueprintInputKind.Choice}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ChoiceInputTemplate}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static blueprints:BlueprintInputKind.Boolean}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource BooleanInputTemplate}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static blueprints:BlueprintInputKind.WholeNumber}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource WholeNumberInputTemplate}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <TextBlock Foreground="#FFD13438"
                                       Text="{Binding ValidationMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Open after generation" />
            <ComboBox Margin="0,4,0,12"
                      ItemsSource="{Binding IdeChoices}"
                      SelectedItem="{Binding IdeId}" />
            <ItemsControl ItemsSource="{Binding ValidationIssues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Foreground="#FFD13438"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Content="Review Plan"
                    Command="{Binding ReviewPlanCommand}"
                    AutomationProperties.Name="Review Plan">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlanPreview}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Border Margin="0,24,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlanPreview}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel DataContext="{Binding PlanPreview}">
                    <TextBlock Style="{StaticResource PageHeading}" Text="Review Plan" />
                    <TextBlock Text="{Binding BlueprintLabel}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TrustLabel, StringFormat=Trust: {0}}" />
                    <TextBlock Text="{Binding PlanHash, StringFormat=Plan hash: {0}}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Git initialization: disabled" Margin="0,8,0,0" />

                    <TextBlock Style="{StaticResource SectionHeading}" Text="Artifacts" Margin="0,16,0,4" />
                    <ListBox ItemsSource="{Binding Artifacts}" DisplayMemberPath="Path"
                             VirtualizingStackPanel.IsVirtualizing="True" />
                    <TextBlock Style="{StaticResource SectionHeading}" Text="Dependencies" Margin="0,16,0,4" />
                    <ListBox ItemsSource="{Binding Dependencies}" DisplayMemberPath="Id"
                             VirtualizingStackPanel.IsVirtualizing="True" />
                    <TextBlock Style="{StaticResource SectionHeading}" Text="Tools" Margin="0,16,0,4" />
                    <ListBox ItemsSource="{Binding Tools}" DisplayMemberPath="Id"
                             VirtualizingStackPanel.IsVirtualizing="True" />
                    <TextBlock Style="{StaticResource SectionHeading}" Text="Steps" Margin="0,16,0,4" />
                    <ListBox ItemsSource="{Binding Steps}"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding HandlerId}" />
                                    <TextBlock Text="{Binding ProcessPreview}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource SectionHeading}" Text="Validators" Margin="0,16,0,4" />
                    <ListBox ItemsSource="{Binding Validators}" DisplayMemberPath="Id"
                             VirtualizingStackPanel.IsVirtualizing="True" />
                    <TextBlock Style="{StaticResource SectionHeading}" Text="Effective inputs" Margin="0,16,0,4" />
                    <ListBox ItemsSource="{Binding Inputs}"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Id}" FontWeight="SemiBold" />
                                    <Run Text=": " />
                                    <Run Text="{Binding DisplayValue}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource SectionHeading}" Text="Features and warnings" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding Features}" />
                    <ItemsControl ItemsSource="{Binding Warnings}" DisplayMemberPath="Message" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Back" Margin="0,0,8,0"
                                Command="{Binding BackToConfigureCommand}" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Create &amp; Validate"
                                Command="{Binding CreateAndValidateCommand}"
                                AutomationProperties.Name="Create and Validate" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <ContentControl Content="{Binding ExecutionCenter}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="{x:Static contracts:ProjectCreationStage.Execute}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate><execution:ExecutionCenterView /></DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
        <ContentControl Content="{Binding LocalReady}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="{x:Static contracts:ProjectCreationStage.LocalReady}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate><execution:LocalReadyView /></DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
        </Grid>
    </ScrollViewer>
</UserControl>
