<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PageHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionTitle}">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="MonospaceEvidence" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Card.CornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource Card.Padding}" />
    </Style>
</ResourceDictionary>
