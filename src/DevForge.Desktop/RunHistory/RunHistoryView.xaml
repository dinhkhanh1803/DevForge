<UserControl x:Class="DevForge.Desktop.RunHistory.RunHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Run History">
    <Grid Margin="{StaticResource Page.Padding}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
            <TextBlock Style="{StaticResource PageHeading}" Text="Run History" />
        </DockPanel>
        <ListBox Grid.Row="1" Margin="0,16,0,0" ItemsSource="{Binding Items}"
                 VirtualizingStackPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding RunId}" FontWeight="SemiBold" />
                            <TextBlock><Run Text="{Binding StatusGlyph}" /><Run Text="{Binding StatusLabel}" /></TextBlock>
                            <TextBlock Text="{Binding ErrorCode}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Resume" IsEnabled="{Binding CanResume}" />
                            <Button Content="Retry" IsEnabled="{Binding CanRetry}" Margin="8,0,0,0" />
                            <Button Content="Cleanup" IsEnabled="{Binding CanCleanup}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
