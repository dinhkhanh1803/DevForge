<UserControl x:Class="DevForge.Desktop.Execution.ExecutionCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Execution Center">
    <Grid Margin="{StaticResource Page.Padding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12"
                        Background="{DynamicResource Brush.AccentSubtle}"
                        VerticalAlignment="Top">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}"
                               Text="{Binding Status.Glyph, Mode=OneWay}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,24,0">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Accent}"
                               FontWeight="SemiBold"
                               Text="PROJECT EXECUTION" />
                    <TextBlock Style="{StaticResource PageHeading}"
                               Margin="0,3,0,0"
                               Text="Execution Center" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Border Style="{StaticResource StatusBadge.Info}">
                            <TextBlock Style="{StaticResource Text.Label}"
                                       Foreground="{DynamicResource Brush.Info}"
                                       Text="{Binding Status.Label, Mode=OneWay}" />
                        </Border>
                        <TextBlock Margin="12,4,0,0"
                                   Style="{StaticResource Text.Caption}"
                                   Text="Live local execution with checkpoint-backed recovery." />
                    </StackPanel>
                    <ProgressBar Height="3"
                                 Margin="0,16,0,0"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource Brush.Accent}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource Button.Danger}"
                        VerticalAlignment="Top"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        AutomationProperties.Name="Cancel execution"
                        AutomationProperties.HelpText="Requests cancellation of the active operation at the next safe checkpoint." />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="7*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Execution timeline" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,0"
                                   Text="Each step is reported from durable execution evidence." />
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             Style="{StaticResource TimelineList}"
                             ItemsSource="{Binding Steps}"
                             SelectedItem="{Binding SelectedStep, Mode=OneWay}"
                             AutomationProperties.Name="Execution timeline">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Raised}" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14"
                                                Background="{DynamicResource Brush.AccentSubtle}"
                                                VerticalAlignment="Top">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       Text="{Binding StatusGlyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.CardTitle}"
                                                           Text="{Binding DisplayName}" />
                                                <Border Grid.Column="1" Style="{StaticResource StatusBadge}">
                                                    <TextBlock Style="{StaticResource Text.Caption}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding StatusLabel}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Style="{StaticResource Text.Caption}"
                                                       Margin="0,4,0,0"
                                                       Text="{Binding Id, StringFormat=Step: {0}}" />
                                            <Border Margin="0,10,0,0" Padding="12">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Callout.Error}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ErrorCode}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Text.Label}"
                                                               Foreground="{DynamicResource Brush.Error}"
                                                               Text="{Binding ErrorCode}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding ErrorSummary}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource Text.Caption}"
                                                               Margin="0,5,0,0"
                                                               Text="{Binding Remediation}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Live output" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0"
                                       Text="Append-only progress from the current session." />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="LOCAL" />
                        </Border>
                    </Grid>
                    <ListBox Grid.Row="1"
                             Style="{StaticResource ConsolePanel}"
                             ItemsSource="{Binding ProgressLines}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Execution output">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource Brush.TextTertiary}" Text="›" />
                                    <TextBlock Grid.Column="1"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding Text}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Callout.Error}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ValidationIssues.Length}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ItemsControl ItemsSource="{Binding ValidationIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2"
                                               Foreground="{DynamicResource Brush.Error}"
                                               Text="{Binding Message}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center"
                           Text="Recovery actions are enabled only when the saved checkpoint permits them." />
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="Resume"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ResumeCommand}"
                            AutomationProperties.Name="Resume execution" />
                    <Button Content="Retry"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding RetryCommand}"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Retry execution" />
                    <Button Content="Cleanup"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding CleanupCommand}"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Clean up owned staging" />
                    <Button Content="Open staging"
                            Style="{StaticResource Button.Ghost}"
                            IsEnabled="False"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Open staging folder"
                            AutomationProperties.HelpText="Disabled until a verified folder-launch capability is available" />
                    <Button Content="Support bundle"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding CreateSupportBundleCommand}"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Create support bundle"
                            AutomationProperties.HelpText="Exports privacy-safe diagnostics from the authoritative run checkpoint" />
                    <Button Content="Copy receipt"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding CopySupportBundleReceiptCommand}"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Copy support bundle receipt" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
