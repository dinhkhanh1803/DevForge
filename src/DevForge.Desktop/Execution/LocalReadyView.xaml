<UserControl x:Class="DevForge.Desktop.Execution.LocalReadyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Local project ready">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Page.Padding}" MaxWidth="840" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageHeading}" Text="LOCAL PROJECT READY" />
            <TextBlock Text="The project passed required validation and is available locally." />
            <TextBlock Margin="0,16,0,0" Text="{Binding TargetDisplayPath, StringFormat=Target: {0}}" />
            <TextBlock Text="{Binding BlueprintLabel, StringFormat=Blueprint: {0}}" />
            <TextBlock Text="{Binding PlanHash, StringFormat=Plan: {0}}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Elapsed, StringFormat=Elapsed: {0}}" />
            <TextBlock Margin="0,16,0,0" Text="{Binding FinalizationState, StringFormat=Finalization: {0}}" />
            <TextBlock Text="{Binding ReportState, StringFormat=Generation report: {0}}" />
            <ListBox ItemsSource="{Binding ReportReferences}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     AutomationProperties.Name="Generation report references" />
            <TextBlock Style="{StaticResource SectionHeading}" Text="Evidence" Margin="0,16,0,4" />
            <ListBox ItemsSource="{Binding Evidence}" DisplayMemberPath="DisplayText"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     AutomationProperties.Name="Execution evidence" />
            <TextBlock Style="{StaticResource SectionHeading}" Text="Warnings" Margin="0,16,0,4" />
            <ListBox ItemsSource="{Binding Warnings}" DisplayMemberPath="Message"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     AutomationProperties.Name="Warnings" />
            <TextBlock Foreground="#FFD13438" Text="{Binding IdeErrorMessage}" Margin="0,12,0,0" />
            <Button Content="Open IDE" Command="{Binding OpenIdeCommand}"
                    HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
