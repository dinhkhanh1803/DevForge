<UserControl x:Class="DevForge.Desktop.Execution.LocalReadyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Project completion">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Page.Padding}"
                    MaxWidth="940"
                    HorizontalAlignment="Left">
            <Border Style="{StaticResource Callout.Success}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26"
                            Background="{DynamicResource Brush.Surface}"
                            VerticalAlignment="Top">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="26"
                                   Foreground="{DynamicResource Brush.Success}"
                                   Text="{StaticResource Icon.Success}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,20,0">
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Success}"
                                   FontWeight="SemiBold"
                                   Text="LOCAL RESULT PROTECTED" />
                        <TextBlock Style="{StaticResource Text.PageTitle}"
                                   Margin="0,3,0,0"
                                   Text="{Binding StatusLabel}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="The validated local project remains safe and available throughout completion."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource Button.Primary}"
                            VerticalAlignment="Center"
                            Content="Open IDE"
                            Command="{Binding OpenIdeCommand}"
                            AutomationProperties.Name="Open IDE" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Completion summary" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0"
                                       Text="Reviewed intent and durable finalization state." />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusBadge.Success}">
                            <TextBlock Style="{StaticResource Text.Label}"
                                       Foreground="{DynamicResource Brush.Success}"
                                       Text="{Binding StatusLabel}" />
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="TARGET" />
                            <TextBlock Margin="0,5,0,14"
                                       FontWeight="SemiBold"
                                       Text="{Binding TargetDisplayPath}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="BLUEPRINT" />
                            <TextBlock Margin="0,5,0,14"
                                       FontWeight="SemiBold"
                                       Text="{Binding BlueprintLabel}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="PLAN HASH" />
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Margin="0,5,0,0"
                                       Text="{Binding PlanHash}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="ELAPSED" />
                            <TextBlock Margin="0,5,0,14" FontWeight="SemiBold" Text="{Binding Elapsed}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="FINALIZATION" />
                            <TextBlock Margin="0,5,0,14" FontWeight="SemiBold" Text="{Binding FinalizationState}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="GENERATION REPORT" />
                            <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding ReportState}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Validation evidence" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,14"
                                   Text="Checks recorded against the generated project." />
                        <ItemsControl ItemsSource="{Binding Evidence}"
                                      AutomationProperties.Name="Execution evidence">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card.Raised}" Margin="0,0,0,8" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="{StaticResource Font.Icon}"
                                                       Foreground="{DynamicResource Brush.Success}"
                                                       Text="{StaticResource Icon.Success}" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource Text.Mono}"
                                                       Margin="10,0,0,0"
                                                       Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Generation reports" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,14"
                                   Text="Durable references for audit and troubleshooting." />
                        <ItemsControl ItemsSource="{Binding ReportReferences}"
                                      AutomationProperties.Name="Generation report references">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card.Raised}" Margin="0,0,0,8" Padding="12">
                                        <TextBlock Style="{StaticResource Text.Mono}"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Callout.Warning}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Warnings.Length}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource Font.Icon}"
                               FontSize="20"
                               Foreground="{DynamicResource Brush.Warning}"
                               Text="{StaticResource Icon.Warning}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="Completed with warnings" />
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding Warnings}"
                                      AutomationProperties.Name="Warnings">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2"
                                               Text="{Binding Message, StringFormat=• {0}}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Publication" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0"
                                       Text="Git and remote publication evidence is separate from local success." />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="CHECKPOINTED" />
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="INITIAL COMMIT" />
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Margin="0,5,0,14"
                                       Text="{Binding InitialCommitId}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="BRANCHES" />
                            <ItemsControl Margin="0,5,0,0"
                                          ItemsSource="{Binding Branches}"
                                          AutomationProperties.Name="Published branches">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Mono}"
                                                   Margin="0,0,0,3"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="REPOSITORY" />
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Margin="0,5,0,14"
                                       Text="{Binding RepositoryUrl}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="PUBLICATION RECEIPTS" />
                            <ItemsControl Margin="0,5,0,0"
                                          ItemsSource="{Binding PublicationReceiptReferences}"
                                          AutomationProperties.Name="Publication receipt references">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Mono}"
                                                   Margin="0,0,0,3"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Callout.Warning}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PublicationErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{StaticResource Font.Icon}"
                                       FontSize="20"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       Text="{StaticResource Icon.Warning}" />
                            <StackPanel Grid.Column="1" Margin="14,0,18,0">
                                <TextBlock Style="{StaticResource Text.CardTitle}" Text="Publication needs attention" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Your validated local project remains safe; only publication is pending."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           FontWeight="SemiBold"
                                           Text="{Binding PublicationErrorMessage}"
                                           TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Margin="0,5,0,0"
                                           Text="{Binding PublicationRemediation}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Secondary}"
                                        Content="Retry publish"
                                        Command="{Binding RetryPublishCommand}"
                                        AutomationProperties.Name="Retry Publish" />
                                <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="True">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPublishing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Callout.Error}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IdeErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource Font.Icon}"
                               FontSize="20"
                               Foreground="{DynamicResource Brush.Error}"
                               Text="{StaticResource Icon.Error}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="Could not open the IDE" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding IdeErrorMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,5,0,0"
                                   Text="The generated project is unaffected and can be opened manually from the target path."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
